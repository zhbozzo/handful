# RevenueCat public SDK key.
# Use the Test Store key (starts with "test_") from RevenueCat → Apps & providers → Test configuration.
# Public SDK keys are designed to ship inside apps, but keep yours out of git anyway.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Only for scripts/setup-revenuecat.mjs (creates products, entitlement and offering).
# A RevenueCat v2 secret key. NEVER prefix with EXPO_PUBLIC_ and never commit it.
REVENUECAT_SECRET_KEY=
REVENUECAT_PROJECT_ID=
